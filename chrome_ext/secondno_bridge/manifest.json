{
  "manifest_version": 3,
  "name": "SecondNo Bridge (Native Messaging)",
  "version": "0.1.0",
  "description": "Demo: communicate with Python via Native Messaging (no ports).",
  "permissions": [
    "debugger",
    "scripting",
    "tabs",
    "activeTab",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://2nd-no.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://2nd-no.com/*"
      ],
      "js": [
        "content_script.js"
      ],
      "run_at": "document_idle"
    }
  ]
}